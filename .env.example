# Bitbucket Server/DC (HTTP Access Token)
BITBUCKET_TOKEN=xxxxxxxxxxxxxxxxxxxx

# GitHub (Personal Access Token)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SonarQube / SonarCloud (User Token)
SONAR_TOKEN=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth method: "token" (default) or "browser" (SSO via Playwright)
# Use "browser" when services are behind OpenID Connect SSO that blocks API tokens
# BITBUCKET_AUTH_METHOD=browser
# SONAR_AUTH_METHOD=browser

# Optional: Override config file paths
CONFIG_PATH=./config.yaml
SONAR_MAPPINGS_PATH=./sonar_key_mappings.yaml

# Corporate proxy (uncomment if behind a proxy)
# HTTPS_PROXY=http://proxy.corp.example.com:8080
# HTTP_PROXY=http://proxy.corp.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# SSL verification (set to false if proxy uses custom/self-signed CA certs)
# SSL_VERIFY=true
